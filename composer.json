{
  "name": "telpassemre/aiui",
  "description": "AI UI Management Panel",
  "type": "project",
  "require": {
    "php": "^8.3",
    "slim/slim": "^4.12",
    "slim/psr7": "^1.6",
    "php-di/php-di": "^7.0",
    "illuminate/database": "^10.0",
    "illuminate/events": "^10.0",
    "predis/predis": "^2.2",
    "monolog/monolog": "^3.5",
    "league/plates": "^3.6",
    "firebase/php-jwt": "^6.10"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
